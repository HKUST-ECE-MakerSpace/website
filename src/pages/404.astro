---
import BaseLayout from "../components/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Page not found — HKUST ECE MakerSpace"
  description="This page doesn't exist at the HKUST ECE MakerSpace."
>
  <section class="notfound">
    <div class="container" style="display: flex; flex-direction: column; align-items: center; gap: var(--s-5);">
      <p class="code" aria-hidden="true">404</p>
      <h1 class="section-title">This circuit's a bit loose.</h1>
      <p class="lede" style="text-align: center;">
        The page you're looking for doesn't exist — but the workshop does.
      </p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn-primary btn-lg" href="/">Back to home</a>
        <a class="btn btn-ghost btn-lg" href="/explore">Explore the space</a>
      </div>
      <p class="footer-about">
        Lost something specific? Email
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
