---
import BaseLayout from "../components/BaseLayout.astro";
import { site } from "../data/site";
import { equipment } from "../data/equipment";

/**
 * Quick-access tiles above the fold. External tiles get the same
 * external-link badge the nav uses.
 */
const quickLinks = [
  {
    label: "Bookings & calendar",
    text: "Reserve machine time and see the lab schedule.",
    href: site.links.calendar,
    external: true,
    icon: "calendar",
  },
  {
    label: "Machine status",
    text: "Live status and guides for every machine.",
    href: site.links.wikiMachines,
    external: true,
    icon: "pulse",
  },
  {
    label: "Component banks",
    text: "Searchable parts grids: check stock before you walk over.",
    href: site.links.wikiBanks,
    external: true,
    icon: "chip",
  },
  {
    label: "Signups & induction status",
    text: "Check your signups and where your induction stands.",
    href: site.links.signups,
    external: true,
    icon: "clipboard",
  },
  {
    label: "Workshops",
    text: "The induction pathway and workshop docs.",
    href: site.links.wikiWorkshops,
    external: true,
    icon: "tool",
  },
  {
    label: "Newsletter",
    text: "Every issue of the newsletter in one place.",
    href: "/community",
    external: false,
    icon: "mail",
  },
] as const;

/** Feather-style stroke icon bodies (24x24). */
const icons: Record<string, string> = {
  calendar:
    '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  pulse:
    '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  chip:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>',
  clipboard:
    '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 13l2 2 4-5"/>',
  tool:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  mail:
    '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
};
---

<BaseLayout
  title="HKUST ECE MakerSpace — hub"
  description="The HKUST ECE MakerSpace hub: machine bookings and calendar, live machine status, component banks, workshops and induction signups. Room 3125A, Lift 22. Open 9:00 AM to 5:30 PM weekdays except public holidays."
>
  {/* ---------- Compact hub hero ---------- */}
  <section class="hero hub-hero">
    <div class="hero-texture" aria-hidden="true"></div>
    <div class="container">
      <p class="eyebrow">HKUST · ECE Department</p>
      <h1 class="hero-title">ECE MakerSpace</h1>
      <p class="hero-lede">
        Room 3125A, Lift 22. Open 9:00 AM to 5:30 PM weekdays except public
        holidays.
      </p>
      <div class="btn-row">
        <a
          class="btn btn-primary btn-lg"
          href={site.links.calendar}
          target="_blank"
          rel="noopener noreferrer"
        >
          Bookings &amp; calendar ↗
        </a>
        <a
          class="btn btn-ghost btn-lg"
          href={site.links.wiki}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open the Wiki ↗
        </a>
      </div>
    </div>
  </section>

  {/* ---------- Quick-access tiles ---------- */}
  <section class="hub-quick" aria-label="Quick access">
    <div class="container">
      <div class="grid grid-3">
        {
          quickLinks.map((link) => (
            <a
              class="hub-tile"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              <span class="hub-tile-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[link.icon]}
                />
              </span>
              <span class="hub-tile-label">
                {link.label}
                {link.external && <span class="badge-ext">↗</span>}
              </span>
              <span class="hub-tile-text">{link.text}</span>
            </a>
          ))
        }
      </div>
      <p class="hub-more">
        Also on the wiki:{" "}
        <a href={site.links.wikiRules} target="_blank" rel="noopener noreferrer">
          lab rules ↗
        </a>{" "}
        and{" "}
        <a href={site.links.wikiFilament} target="_blank" rel="noopener noreferrer">
          filament stock ↗
        </a>
      </p>
    </div>
  </section>

  {/* ---------- This week in the lab ---------- */}
  <section class="section-tight" aria-label="This week in the lab">
    <div class="container">
      <a class="card is-link hub-strip" href="/events" data-reveal>
        <div class="hub-strip-body">
          <p class="eyebrow">This week in the lab</p>
          <h2 class="card-title">Workshops, inductions and events</h2>
          <p class="card-text">
            Dates go up on the event calendar and the Events page embeds it
            live, so check there before you plan a build.
          </p>
        </div>
        <span class="go">Open Events</span>
      </a>
    </div>
  </section>

  {/* ---------- Equipment teaser ---------- */}
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Equipment</p>
        <h2 class="section-title">What's in the lab</h2>
        <p class="lede">
          Every station is free for members once you're inducted.
          Workshop-area machines take a little more training first.
        </p>
        <a class="more-link" href="/explore">See all equipment</a>
      </div>
      <div class="grid grid-3">
        {
          equipment.map((cat, i) => (
            <a class="card is-link" href="/explore" data-reveal style={`--d: ${(i % 3) * 0.08}s;`}>
              <div class="card-media">
                <img
                  src={cat.photos[0].src}
                  alt={cat.photos[0].alt}
                  width={cat.photos[0].width}
                  height={cat.photos[0].height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-body">
                <h3 class="card-title">{cat.title}</h3>
                <p class="card-text">{cat.blurb}</p>
                <span class="go">Explore</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- FAQ teaser ---------- */}
  <section class="section-tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">The usual questions, answered</h2>
        <p class="lede">
          Membership, using the space, safety, events: the FAQ covers all of
          it.
        </p>
        <a class="more-link" href="/faq">Read the FAQ</a>
      </div>
    </div>
  </section>

  {/* ---------- Contact strip ---------- */}
  <section class="strip" aria-label="Contact and directions">
    <div class="container strip-inner" data-reveal>
      <div>
        <p class="strip-title">
          <span>Not sure about something? Email <a href={`mailto:${site.email}`}>{site.email}</a></span>
        </p>
        <div class="hub-addresses">
          <address>
            <span class="hub-address-name">ECE MakerSpace</span>
            {site.space.lines.join(", ")}
          </address>
          <address>
            <span class="hub-address-name">ECE Department</span>
            {site.dept.lines.join(", ")}
          </address>
        </div>
      </div>
      <a
        class="btn btn-ghost"
        href={site.links.directions}
        target="_blank"
        rel="noopener noreferrer"
      >
        Find the room ↗
      </a>
    </div>
  </section>
</BaseLayout>
