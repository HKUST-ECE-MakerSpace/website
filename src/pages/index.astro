---
import BaseLayout from "../components/BaseLayout.astro";
import { site } from "../data/site";
import { equipment } from "../data/equipment";

const rotors = {
  nouns: ["Desire", "Idea", "Dream", "Vision"],
  verbs: ["Fuel", "Equip", "Power", "Launch"],
};
---

<BaseLayout
  title="HKUST ECE MakerSpace | The Dream Workshop for Big Ideas"
  description="A free workshop for ECE students at HKUST, in Room 3125A: 3D printers, laser cutters, resin printers, oscilloscopes and a mechanical workspace. Open to ELEC, MEIC & CPEG and Year 1 Undeclared students."
>
  {/* ---------- Hero ---------- */}
  <section class="hero">
    <div class="hero-texture" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">HKUST · {site.dept.name}</p>
        <h1 class="hero-title">
          The <em>Dream</em> Workshop for <em>Big</em> Ideas
        </h1>
        <p class="hero-lede">
          Prototypes, personal projects, ideas at 3am: build them here.
          Membership is free and open to ECE students (ELEC, MEIC &amp; CPEG)
          and Year 1 Undeclared majors.
        </p>
        <div class="btn-row">
          <a
            class="btn btn-primary btn-lg"
            href={site.links.joinForm}
            target="_blank"
            rel="noopener noreferrer"
          >
            Join Us
          </a>
          <a class="btn btn-ghost btn-lg" href="/explore">Explore facilities</a>
        </div>
      </div>
      <figure class="hero-figure" aria-hidden="true">
        <img
          src="/images/home-hero-graphic.png"
          alt=""
          width="1024"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  {/* ---------- Media band: bench photo + word rotator ---------- */}
  <section class="band section-tight" data-reveal>
    <div class="container split">
      <figure class="frame-photo">
        <img
          src="/images/bench-oscilloscope.webp"
          alt="Siglent oscilloscope bench at the ECE MakerSpace"
          width="1024"
          height="683"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div>
        <p class="eyebrow">Your space</p>
        <p class="rotor-line">
          <span class="sr-only">Your dream? We launch it.</span>
          <span aria-hidden="true">
            Your
            <span class="rotor" style="--n: 4;">
              {rotors.nouns.map((word, i) => (
                <span style={`--i: ${i};`}>{word}</span>
              ))}
            </span>
            ?
          </span>
        </p>
        <p class="rotor-line" style="margin-bottom: var(--s-5);">
          <span aria-hidden="true">
            We
            <span class="rotor" style="--n: 4;">
              {rotors.verbs.map((word, i) => (
                <span style={`--i: ${i};`}>{word}</span>
              ))}
            </span>
            it.
          </span>
        </p>
        <p class="lede">
          A full electronics and fabrication workshop on the Main Campus.
          Members pay nothing and book nothing; if a machine is free, it's
          yours.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- Eligibility strip ---------- */}
  <section class="strip">
    <div class="container strip-inner" data-reveal>
      <p class="strip-title">{site.eligibility}</p>
      <a
        class="btn btn-ghost"
        href={site.links.policyPdf}
        target="_blank"
        rel="noopener noreferrer"
      >
        Membership Policy
      </a>
    </div>
  </section>

  {/* ---------- Facilities preview ---------- */}
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Explore</p>
        <h2 class="section-title">Meet our equipment</h2>
        <p class="lede">
          Every station is free for members once you're inducted.
          Workshop-area machines take a little more training first.
        </p>
        <a class="more-link" href="/explore">See all facilities</a>
      </div>
      <div class="grid grid-3">
        {
          equipment.map((cat, i) => (
            <a class="card is-link" href="/explore" data-reveal style={`--d: ${(i % 3) * 0.08}s;`}>
              <div class="card-media">
                <img
                  src={cat.photos[0].src}
                  alt={cat.photos[0].alt}
                  width={cat.photos[0].width}
                  height={cat.photos[0].height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-body">
                <h3 class="card-title">{cat.title}</h3>
                <p class="card-text">{cat.blurb}</p>
                <span class="go">Explore</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Events preview ---------- */}
  <section class="section band">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Events</p>
        <h2 class="section-title">Workshops &amp; events</h2>
        <p class="lede">
          Workshops run regularly, covering electronics topics from PCB
          design to soldering. Dates go up on the event calendar.
        </p>
        <a class="more-link" href="/events">See the calendar</a>
      </div>
      <div class="grid grid-2">
        <a class="card is-link" href="/events" data-reveal>
          <div class="card-media">
            <img
              src="/images/events-hero.jpg"
              alt="Students gathered around a workbench during a MakerSpace workshop"
              width="2560"
              height="1707"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="card-body">
            <h3 class="card-title">Upcoming workshops</h3>
            <p class="card-text">
              Induction training and enrichment workshops all go up on the
              event calendar, so check there first.
            </p>
            <span class="go">Events</span>
          </div>
        </a>
        <a class="card is-link" href="/community" data-reveal style="--d: 0.08s;">
          <div class="card-media">
            <img
              src="/images/industry-day.jpeg"
              alt="The MakerSpace booth at Industry Day 2025"
              width="2276"
              height="1517"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="card-body">
            <h3 class="card-title">Industry Day 2025</h3>
            <p class="card-text">
              Photos from Industry Day 2025, plus every issue of our
              newsletter.
            </p>
            <span class="go">Community</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ---------- MakerWIKI callout ---------- */}
  <section class="section">
    <div class="container">
      <div class="feature-panel" data-reveal>
        <div>
          <p class="eyebrow">MakerWIKI</p>
          <h2 class="section-title">MakerWIKI is up</h2>
          <p class="lede" style="margin-bottom: var(--s-5);">
            The wiki tracks live machine status and keeps the component
            banks and workshop docs. Check it before you start a build.
          </p>
          <div class="btn-row">
            <a
              class="btn btn-primary"
              href={site.links.wiki}
              target="_blank"
              rel="noopener noreferrer"
            >
              Open the Wiki ↗
            </a>
            <a
              class="btn btn-ghost"
              href={site.links.wikiBanks}
              target="_blank"
              rel="noopener noreferrer"
            >
              Component banks
            </a>
          </div>
        </div>
        <div class="browser-frame">
          <div class="browser-bar" aria-hidden="true">
            <i></i><i></i><i></i>
            <span>wiki.ecemaker.space</span>
          </div>
          <img
            src="/images/wiki-banner.png"
            alt="Screenshot of the MakerWIKI homepage showing live machine status"
            width="1826"
            height="1017"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Community teaser ---------- */}
  <section class="section band">
    <div class="container split">
      <figure class="frame-photo" data-reveal>
        <img
          src="/images/community-team.jpg"
          alt="MakerSpace members collaborating on a project"
          width="2560"
          height="1440"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div data-reveal style="--d: 0.1s;">
        <p class="eyebrow">Community</p>
        <h2 class="section-title">Find people to build with</h2>
        <p class="lede" style="margin-bottom: var(--s-5);">
          Members swap ideas and find project teammates in the WhatsApp
          Community and Discord server, and what they make shows up in the
          newsletter.
        </p>
        <a class="btn btn-ghost" href="/community">Community &amp; newsletter</a>
      </div>
    </div>
  </section>

  {/* ---------- Join CTA band ---------- */}
  <section class="cta-band">
    <div class="hero-photo" aria-hidden="true">
      <img
        src="/images/workshop-night.jpg"
        alt=""
        width="1818"
        height="1212"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container">
      <h2 class="hero-title">JOIN US and START BUILDING!</h2>
      <p class="lede" style="text-align: center;">
        There's no membership fee and no selection process: complete the
        sign-up form, pass the intro safety course, attend two induction
        workshops, and the space is yours.
      </p>
      <div class="btn-row" style="justify-content: center;">
        <a class="btn btn-primary btn-lg" href="/join">Become a member</a>
      </div>
    </div>
  </section>
</BaseLayout>
