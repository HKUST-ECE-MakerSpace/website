---
import { navLinks, site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => !href.startsWith("http") && path === href;
---

<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-plate">
        <img
          src="/images/logo-dept.png"
          alt=""
          width="473"
          height="60"
          loading="eager"
          decoding="async"
        />
      </span>
    </a>

    <nav aria-label="Main">
      <ul class="nav-links">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
                {link.external && <span class="badge-ext">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn-primary btn-sm nav-cta" href="/join">Join Us</a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <div class="mobile-panel" id="mobile-menu">
    <ul>
      <li><a href="/">Home</a></li>
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
              {link.external && <span class="badge-ext">↗</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn-primary btn-lg" href="/join">Join Us</a>
  </div>
</header>
