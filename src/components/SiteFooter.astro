---
import { navLinks, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-brand">
          <img
            src="/images/makerspace-crest.png"
            alt="ECE MakerSpace crest"
            width="437"
            height="443"
            loading="lazy"
            decoding="async"
          />
          <p class="name">
            {site.shortName}
            <small>{site.tagline}</small>
          </p>
        </div>
        <p class="footer-about">
          A student workshop affiliated with the {site.dept.name} at HKUST —
          open to ELEC, MEIC &amp; CPEG students and Year 1 Undeclared majors.
        </p>
        <div class="social-row">
          <a
            href={site.links.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram (HKUST university account)"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect>
              <circle cx="12" cy="12" r="4.2"></circle>
              <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a
            href={site.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn (HKUST university account)"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S.02 4.88.02 3.5 1.13 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4v15h-4V8zm7.5 0h3.8v2.05h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V23h-4v-7.9c0-1.88-.03-4.3-2.62-4.3-2.62 0-3.02 2.05-3.02 4.16V23H8V8z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Visit us</h2>
        <address>
          <strong>{site.dept.name}</strong><br />
          {site.dept.lines.map((line) => (<>{line}<br /></>))}
        </address>
        <address>
          <strong>MakerSpace</strong><br />
          {site.space.lines.map((line) => (<>{line}<br /></>))}
        </address>
        <a
          href={site.links.directions}
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Directions ↗
        </a>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Site</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}{link.external ? " ↗" : ""}
              </a>
            </li>
          ))}
          <li><a href="/join">Join Us</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Resources</h2>
        <ul>
          <li>
            <a href={site.links.wiki} target="_blank" rel="noopener noreferrer">MakerWIKI ↗</a>
          </li>
          <li>
            <a href={site.links.wikiBanks} target="_blank" rel="noopener noreferrer">
              Component banks ↗
            </a>
          </li>
          <li>
            <a href={site.links.policyPdf} target="_blank" rel="noopener noreferrer">
              Membership Policy (PDF) ↗
            </a>
          </li>
          <li><a href="/events">Event calendar</a></li>
          <li>
            <a href={site.links.eceDept} target="_blank" rel="noopener noreferrer">
              ECE Department ↗
            </a>
          </li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <a href={site.links.hkust} target="_blank" rel="noopener noreferrer">
        <img src="/images/hkust-logo.svg" alt="HKUST Logo" width="150" height="48" loading="lazy" />
      </a>
      <span>Copyright © The Hong Kong University of Science and Technology. All rights reserved.</span>
      <a href={site.links.privacy} target="_blank" rel="noopener noreferrer">Privacy</a>
      <span class="legal">Built by makers, for makers · {year}</span>
    </div>
  </div>
</footer>
